{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://family-os.internal/schemas/bip/application-report.schema.json",
  "title": "BIP Application Report Schema",
  "description": "Schema for application audit, inventory summary, and quality gate reports.",
  "type": "object",
  "required": [
    "report_id",
    "app_id",
    "app_display_name",
    "source_path",
    "program_phase",
    "pilot_flag",
    "inventory_summary",
    "resource_summary",
    "evidence_summary",
    "relationships_summary",
    "quality_gate_passed",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^REP-[A-Z0-9]+-[0-9]{3}$",
      "description": "Unique report identifier (e.g. REP-TG-001)."
    },
    "app_id": {
      "type": "string",
      "enum": [
        "telegram",
        "familywall",
        "life360",
        "qustodio",
        "quizlet",
        "famisafe",
        "bark",
        "muslim-pro",
        "notebooklm"
      ],
      "description": "Unified logical application identifier."
    },
    "app_display_name": {
      "type": "string",
      "description": "Human-readable application name."
    },
    "source_path": {
      "type": "string",
      "description": "Actual physical directory on disk containing the decompiled or teardown assets."
    },
    "program_phase": {
      "type": "string",
      "enum": [
        "BIP-00",
        "BIP-01",
        "BIP-02",
        "BIP-03",
        "BIP-04",
        "BIP-05",
        "BIP-06",
        "BIP-07",
        "BIP-08"
      ],
      "description": "Program phase during which this report was produced."
    },
    "pilot_flag": {
      "type": "boolean",
      "description": "True if this report represents a limited pilot sample (PILOT_ONLY)."
    },
    "inventory_summary": {
      "type": "object",
      "required": ["total_files_discovered", "total_bytes", "counts_by_level", "counts_by_type"],
      "additionalProperties": false,
      "properties": {
        "total_files_discovered": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "counts_by_level": {
          "type": "object",
          "required": ["T0", "T1", "T2", "T3"],
          "additionalProperties": false,
          "properties": {
            "T0": { "type": "integer", "minimum": 0 },
            "T1": { "type": "integer", "minimum": 0 },
            "T2": { "type": "integer", "minimum": 0 },
            "T3": { "type": "integer", "minimum": 0 }
          }
        },
        "counts_by_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "resource_summary": {
      "type": "object",
      "required": ["total_resources_cataloged", "counts_by_category"],
      "additionalProperties": false,
      "properties": {
        "total_resources_cataloged": { "type": "integer", "minimum": 0 },
        "counts_by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": ["total_evidence_records", "counts_by_tag"],
      "additionalProperties": false,
      "properties": {
        "total_evidence_records": { "type": "integer", "minimum": 0 },
        "counts_by_tag": {
          "type": "object",
          "required": ["REF", "ASSUMPTION", "PENDING-REF", "PARTIAL-EVIDENCE"],
          "additionalProperties": false,
          "properties": {
            "REF": { "type": "integer", "minimum": 0 },
            "ASSUMPTION": { "type": "integer", "minimum": 0 },
            "PENDING-REF": { "type": "integer", "minimum": 0 },
            "PARTIAL-EVIDENCE": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "relationships_summary": {
      "type": "object",
      "required": ["total_relationships", "counts_by_type"],
      "additionalProperties": false,
      "properties": {
        "total_relationships": { "type": "integer", "minimum": 0 },
        "counts_by_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "quality_gate_passed": {
      "type": "boolean",
      "description": "Whether all automated verification and audit checks passed without error."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when report was generated in ISO 8601 format."
    }
  }
}
